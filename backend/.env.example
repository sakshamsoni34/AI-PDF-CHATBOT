# Google Gemini API Key (Required for embeddings and LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace API Key (Optional fallback)
HUGGINGFACE_API_KEY=

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=chatbot

# Alternative: Cloud Database URL (Render / Railway / Aiven / RDS)
# DATABASE_URL=mysql://root:password@localhost:3306/chatbot

# Optional SSL CA certificate path for managed cloud MySQL
# DB_SSL_CA=/path/to/ca.pem

# Security
JWT_SECRET=your_production_jwt_secret_key_change_me
PORT=8001

# Allowed Frontend Origins (Comma-separated for production CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://your-frontend.vercel.app

# Upload and Log directories (optional, default to ./uploads and ./logs)
# UPLOAD_DIR=/data/uploads
# LOG_DIR=/data/logs

